# PostgreSQL container settings (used by docker-compose.yaml)
POSTGRES_DB=sentiment_analyzer
POSTGRES_USER=sentiment_analyzer
POSTGRES_PASSWORD=change-me

# Application database connection
DATABASE_URL=postgres://sentiment_analyzer:change-me@localhost:5432/sentiment_analyzer
MAX_POOL_SIZE=10
RUN_MIGRATIONS=true

# Source texts and document-analysis metadata are removed after this many days.
SENTIMENT_RESULT_RETENTION_DAYS=30

# Server and model assets
SERVER_ADDRESS=0.0.0.0:3000
MODEL_PATH=models/model.onnx
TOKENIZER_PATH=models/tokenizer.json

# JSON /predict request limits. Document uploads will use a separate limit.
PREDICT_MAX_BODY_BYTES=65536
DOCUMENT_MAX_BODY_BYTES=10485760
DOCUMENT_MAX_CHARACTERS=1000000
DOCUMENT_EXTRACTION_CONCURRENCY=1
DOCUMENT_EXTRACTION_QUEUE_TIMEOUT_MS=1000
DOCUMENT_EXTRACTION_TIMEOUT_MS=10000

# ONNX inference limits
MODEL_MAX_TOKENS=512
INFERENCE_QUEUE_TIMEOUT_MS=1000
INFERENCE_TIMEOUT_MS=10000
